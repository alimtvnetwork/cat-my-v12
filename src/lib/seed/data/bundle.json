        "name": "Neck Anchor",
        "kind": "S",
        "family": "anchor",
        "x": 300,
        "y": 140,
        "width": 20,
        "height": 20
      }
    },
    {
      "id": "tmpl-math-verdict",
      "label": "Math verdict combiner",
      "kind": "E",
      "description": "Expression rule that combines upstream measurements into a single pass/fail number.",
