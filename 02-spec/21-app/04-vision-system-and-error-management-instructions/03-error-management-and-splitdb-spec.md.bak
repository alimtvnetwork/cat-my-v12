## 7. Concrete Code Remediation Details

### 7.1 Remediation: `src/lib/observability/cliSessions.functions.ts`

```typescript
// BEFORE (Swallows errors into fake empty state)
} catch (err) {
  const isEnvelope = err instanceof Error && (err.name === "EnvelopeError" || "responseStatus" in err);
  const envErr = err as any;
  if (isEnvelope && (envErr.responseStatus === 404 || envErr.code === "E_BE_UNAVAILABLE")) {
    return { items: [], total: 0, limit: data.limit ?? 50 };
  }
  throw err;
}

// AFTER (Logs structured error and rethrows with envelope context)
} catch (err) {
  const errorMessage = err instanceof Error ? err.message : String(err);
  ClientLogger.error("[cliSessions.functions] Failed to fetch CLI sessions from backend", {
    error: errorMessage,
    source: data.source ?? "all",
    limit: data.limit ?? 50,
  });

  // Re-throw so TanStack Router ErrorBoundary can render the server failure banner
  throw new Error(`CLI_SESSIONS_FETCH_FAILED: ${errorMessage}`);
}
```

### 7.2 Remediation: `src/lib/observability/savedViews.ts`

```typescript
// BEFORE (Returns { ok: false } and swallows parse/quota errors)
function safeRead(): SavedView[] {
  try {
    const raw = window.localStorage.getItem(STORAGE_KEY);
    if (!raw) return [];
    return JSON.parse(raw);
  } catch (e) {
    ClientLogger.warn("[savedViews] read failed; treating as empty", { error: msg });
    return [];
  }
}

// AFTER (Affirmative booleans and Result envelope)
export interface SavedViewResult {
  isSuccess: boolean;
  hasError: boolean;
  views: SavedView[];
  errorMessage?: string;
}

export function readSavedViewsResult(): SavedViewResult {
  if (typeof window === "undefined") {
    return { isSuccess: true, hasError: false, views: [] };
  }
  try {
    const raw = window.localStorage.getItem(STORAGE_KEY);
    if (!raw) return { isSuccess: true, hasError: false, views: [] };
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) {
      throw new Error("Persisted saved views payload is not an array");
    }
    return { isSuccess: true, hasError: false, views: parsed };
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    ClientLogger.error("[savedViews] Corrupt saved views storage detected", { error: message });
    return { isSuccess: false, hasError: true, views: [], errorMessage: message };
  }
}
```

### 7.3 Remediation: `src/components/hmi/CameraPreview.tsx`

```typescript
// BEFORE (Swallows play rejection and discards acquisition error)
videoRef.current.play().catch(() => undefined);
// ...
.catch(() => {
  if (!isCancelled) setStatus("denied");
});

// AFTER (Extracts DOMException, logs structured event, notifies error boundary)
videoRef.current.play().catch((err: unknown) => {
  const msg = err instanceof Error ? err.message : String(err);
  ClientLogger.warn("[CameraPreview] video.play() was interrupted or rejected", { error: msg });
});
// ...
.catch((err: unknown) => {
  if (isCancelled) return;
  const errorObj = err instanceof DOMException ? err : new Error(String(err));
  ClientLogger.error("[CameraPreview] Hardware camera stream acquisition failed", {
    name: errorObj.name,
    message: errorObj.message,
    cameraId: selectedCameraId,
  });
  setErrorMessage(`${errorObj.name}: ${errorObj.message}`);
  setStatus("denied");
});
```

---

## 8. Verification & Acceptance Criteria

1. **Zero Error Swallowing**: A static analysis regex scan across `src/lib/observability/`, `src/lib/stores/`, and `src/components/hmi/` yields zero empty `catch {}` blocks or catch blocks returning fake `[]` / `null` / `false`.
2. **SplitDB Compliance**:
   - `data/errors.db` exists with WAL mode enabled.
   - `ErrorLog` and `ErrorBreadcrumb` tables are created with PascalCase column names and UTC integer epoch timestamps.
   - All boolean columns strictly use `Has` / `Is` prefix with non-null `0` or `1`.
3. **CLI Error Inspector Functionality**:
   - Running `cat-cli errors list` returns an exit code of `0` and a formatted table of logged exceptions.
   - Running `cat-cli errors inspect <uuid>` displays the colorized step-by-step stack trace.
4. **FastAPI Contract**: All error ingestion endpoints return responses wrapped in the Universal Response Envelope (`{ Status, Results, Errors }`).
