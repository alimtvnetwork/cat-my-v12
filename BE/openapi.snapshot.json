    "/api/cli/sessions/{run_id}/log": {
      "get": {
        "summary": "Get Cli Session Log",
        "description": "SSE tail of a CLI session's JSONL log by `RunId`.\n\nReturns `404 E_BE_NOT_FOUND` if no session on disk carries this RunId.\nOn success, emits `data:` frames per JSONL line followed by an `end`\nevent carrying the final line cursor for resumable polling.",
        "operationId": "get_cli_session_log_api_cli_sessions__run_id__log_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "since_line",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "1-based; skip first N lines",
              "default": 0,
              "title": "Since Line"
            },
            "description": "1-based; skip first N lines"
          },
          {
            "name": "max_lines",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "1..5000",
              "default": 1000,
              "title": "Max Lines"
            },
            "description": "1..5000"
          },
          {
            "name": "follow",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Poll for new lines up to 30s",
              "default": false,
              "title": "Follow"
            },
            "description": "Poll for new lines up to 30s"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
