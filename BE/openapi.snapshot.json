      "post": {
        "summary": "Create Sample",
        "description": "Insert a sample via `SampleFacade.upsert_sample` (Plan 90 Step 145).\n\nPOST allows the client to mint a specific `id` (the samples slice uses\nmonotonic client-side integer aliases per `src/lib/ids/int-alias.ts`, so\nthe id is authoritative, not server-assigned). Idempotent by id: a second\nPOST with the same id updates the row rather than 409-ing, matching the\nfacade's upsert semantics. Bad payload \u2192 400 `E_BE_BAD_REQUEST`.",
        "operationId": "create_sample_samples_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
