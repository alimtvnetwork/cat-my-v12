    "/observability/sessions": {
      "get": {
        "summary": "List Sessions",
        "description": "List recent CLI invocations from Root-DB, ordered per ``sort``/``dir``.\n\nPagination\n----------\nResponse includes ``nextCursor`` (opaque string or ``null``). When\nnon-null, pass it back verbatim as ``?cursor=<token>`` to fetch the\nnext page under the same ``sort``/``dir``/filters. Do not decode or\nfabricate cursors; the server treats invalid tokens as bad input.",
        "operationId": "list_sessions_observability_sessions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "1..500, default 50",
              "default": 50,
              "title": "Limit"
            },
            "description": "1..500, default 50"
          },
          {
            "name": "cli",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "worker-cli | processing-cli",
              "title": "Cli"
            },
            "description": "worker-cli | processing-cli"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "active | success | failure",
              "title": "Status"
            },
            "description": "active | success | failure"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "StartedAt | CliName | Status | DurationMs",
              "title": "Sort"
            },
            "description": "StartedAt | CliName | Status | DurationMs"
          },
          {
            "name": "dir",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "asc | desc (default desc)",
              "title": "Dir"
            },
            "description": "asc | desc (default desc)"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "opaque cursor from nextCursor",
              "title": "Cursor"
            },
            "description": "opaque cursor from nextCursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
