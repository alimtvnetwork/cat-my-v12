    "/rules/{rule_id}": {
      "get": {
        "summary": "Get Rule",
        "description": "Fetch one rule via the active `RuleFacade`.\n\nThe facade owns the `E_BE_NOT_FOUND` decision; this handler only validates\nthe path param and lets `AppError` propagate to the Step-13 handlers.",
        "operationId": "get_rule_rules__rule_id__get",
        "parameters": [
          {
            "name": "rule_id",
            "in": "path",
            "required": true,
