{
  "manifest_version": 3,
  "name": "App Shell",
  "version": "1.0",
  "description": "Chromium shell for App",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "windows"]
}
