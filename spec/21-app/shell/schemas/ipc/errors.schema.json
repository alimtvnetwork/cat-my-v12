{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "errors.schema.json",
  "title": "errors IPC group",
  "description": "Request and response schemas for error listing.",
  "$defs": {
    "errors.list.req": {
      "type": "object",
      "required": ["cid", "method", "params"],
      "properties": {
        "cid": { "type": "string", "format": "uuid" },
        "method": { "const": "errors.list" },
        "params": {
          "type": "object",
          "properties": {
            "severity": { "enum": ["info", "warning", "error"] },
            "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errors.list.res": {
      "type": "object",
      "required": ["cid", "code", "data"],
      "properties": {
        "cid": { "type": "string", "format": "uuid" },
        "code": { "enum": ["I_ERRORS_LISTED", "E_ERRORS_LIST_FAILED"] },
        "data": {
          "type": "object",
          "required": ["items"],
          "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/error.item" } } },
          "additionalProperties": false
        },
        "remediation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "error.item": {
      "type": "object",
      "required": ["code", "message", "ts"],
      "properties": {
        "code": { "type": "string", "pattern": "^[IEW]_[A-Z0-9_]+$" },
        "message": { "type": "string" },
        "ts": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
